generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model diagnosis_history {
  id               Int       @id @default(autoincrement())
  patient_id       String    @db.VarChar(50)
  symptoms         String
  diagnosis_result Json
  created_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([created_at], map: "idx_diagnosis_created_at")
  @@index([patient_id], map: "idx_diagnosis_patient_id")
}

model magic_links {
  id         Int       @id @default(autoincrement())
  patient_id Int
  token      String    @unique @db.VarChar(255)
  expires_at DateTime  @db.Timestamp(6)
  used       Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  patients   patients  @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_magic_links_expires")
  @@index([token], map: "idx_magic_links_token")
}

model patients {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(100)
  email          String        @unique @db.VarChar(255)
  age            Int?
  condition      String?       @db.VarChar(255)
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  specialty      String?       @db.VarChar(255)
  hospital       String?       @db.VarChar(255)
  location       String?       @db.VarChar(255)
  license_number String?       @db.VarChar(100)
  magic_links    magic_links[]
}
