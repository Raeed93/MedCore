server:
  build: ./server
  ports:
    - "3000:3000"
  volumes:
    - ./server:/app
    - /app/node_modules
  env_file:
    - server/.env      # ← ADD THIS LINE
  environment:
    - NODE_ENV=development
    - POSTGRES_USER=admin
    - POSTGRES_PASSWORD=password123
    - POSTGRES_DB=medcore_ai
    - PGHOST=db
    - AI_SERVICE_URL=http://ai-service:8000
  depends_on:
    - db
    - ai-service